{
  "design": {
    "hypothesis": "Showing social proof on the pricing page will increase paid conversion.",
    "control": "Existing pricing page",
    "treatment": "Pricing page with customer logos and testimonial",
    "primary_metric": { "name": "Subscription conversion", "direction": "increase", "minimum_detectable_effect": 0.05 },
    "secondary_metrics": [{ "name": "Pricing CTA click-through", "direction": "increase" }],
    "guardrail_metrics": [{ "name": "Support ticket rate", "direction": "decrease" }],
    "baseline_rate": 0.08,
    "expected_relative_lift": 0.05,
    "alpha": 0.05,
    "power": 0.8,
    "allocation": 0.5,
    "daily_eligible_users": 12000,
    "minimum_days": 14,
    "planned_looks": 1,
    "randomization_unit": "user"
  },
  "observation": {
    "experiment_id": "social-proof-pricing-v1",
    "primary": {
      "name": "Subscription conversion",
      "direction": "increase",
      "control": { "visitors": 100000, "conversions": 8100 },
      "treatment": { "visitors": 100000, "conversions": 8800 }
    },
    "guardrails": [{
      "name": "Support ticket rate",
      "direction": "decrease",
      "guardrail_threshold": 0.002,
      "control": { "visitors": 100000, "conversions": 500 },
      "treatment": { "visitors": 100000, "conversions": 620 }
    }],
    "days_running": 14,
    "decision_looks": 1,
    "segments": {
      "platform": [
        { "name": "Android", "direction": "increase", "control": { "visitors": 40000, "conversions": 3120 }, "treatment": { "visitors": 40000, "conversions": 3480 } },
        { "name": "Web", "direction": "increase", "control": { "visitors": 60000, "conversions": 4980 }, "treatment": { "visitors": 60000, "conversions": 5340 } }
      ]
    }
  }
}
